{
  "name": "todo-test",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.22.2 <25",
    "npm": ">=11 <12"
  },
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "generate": "nuxt generate",
    "postinstall": "nuxt prepare",
    "prepare": "node scripts/prepare-hooks.mjs",
    "typecheck": "nuxt typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test": "vitest",
    "test:run": "vitest run",
    "check": "npm run lint && npm run typecheck && npm run test:run && npm run format:check"
  },
  "dependencies": {
    "@pinia/nuxt": "1.0.3",
    "nuxt": "4.6.4",
    "pinia": "^4.1.0",
    "vue": "^3.5.0",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@nuxt/eslint": "1.17.0",
    "@types/node": "^24.0.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.0.0",
    "prettier": "^3.6.0",
    "sass-embedded": "^1.93.0",
    "typescript": "~6.0.3",
    "vitest": "~5.1.0",
    "vue-tsc": "3.3.14"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,mts,cts,vue}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{scss,css,json,jsonc,md,yaml,yml}": "prettier --write"
  }
}
